# Copy to .env.local and fill in. Never commit real secrets.

# ── Database ────────────────────────────────────────────────
# Postgres with the pgvector extension (e.g. Neon/Supabase).
# On serverless (Vercel), use the POOLED connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI (chat + embeddings) ──────────────────────────────────
# Google AI Studio key — free tier. Powers gemini-3.5-flash-lite
# (chat) and gemini-embedding-001 (RAG embeddings).
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Auth (single admin) ─────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@paysense.co
# base64-encoded bcrypt hash — see README (dotenv strips $ from raw hashes)
ADMIN_PASSWORD_HASH=

# ── App URL ─────────────────────────────────────────────────
# Fallback for Stripe redirect URLs (the code prefers the live request origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=

# ── M-Pesa (Daraja) ─────────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a public HTTPS URL (use ngrok locally).
MPESA_CALLBACK_URL=https://your-domain/api/webhooks/mpesa

# ── Email receipts (optional — no-ops if unset) ─────────────
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=onboarding@resend.dev
